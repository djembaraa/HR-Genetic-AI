generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Multi-Tenant Root ---

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug        String   @unique
  description String?
  industry    String?
  website     String?
  logoUrl     String?
  users       User[]
  jobs        Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Authentication & Authorization ---

enum Role {
  ADMIN
  HR_MANAGER
  RECRUITER
  CANDIDATE
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  role      Role       @default(CANDIDATE) // ADMIN, HR_MANAGER, RECRUITER, CANDIDATE
  companyId Int?
  company   Company?   @relation(fields: [companyId], references: [id])
  candidate Candidate?
  refreshTokens RefreshToken[]
  notifications Notification[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyId])
  @@index([role])
}

// --- Security & Audit ---

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// --- Job Postings ---

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

model Job {
  id          Int         @id @default(autoincrement())
  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])
  title       String
  department  String
  description String
  location    String      @default("")
  type        JobType     @default(FULL_TIME)
  status      JobStatus   @default(OPEN)
  applications JobApplication[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
}

// --- Candidate Profile ---

enum VectorizationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Candidate {
  id                   Int          @id @default(autoincrement())
  userId               Int          @unique
  user                 User         @relation(fields: [userId], references: [id])
  name                 String
  email                String       @unique
  phone                String?
  location             String?
  summary              String?
  linkedinUrl          String?
  githubUrl            String?
  websiteUrl           String?
  salaryExpectation    String?
  cvFileName           String?
  vectorizationStatus  VectorizationStatus @default(PENDING)
  experiences          Experience[]
  educations           Education[]
  skills               Skill[]
  projects             Project[]
  certifications       Certification[]
  languages            Language[]
  awards               Award[]
  applications         JobApplication[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([email])
  @@index([vectorizationStatus])
}

// --- Job Application ---

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  REJECTED
  HIRED
}

model JobApplication {
  id          Int       @id @default(autoincrement())
  candidateId Int
  jobId       Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(APPLIED)
  interviews  Interview[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
}

// --- Structured Resume: Work Experience ---

model Experience {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     String
  title       String
  description String    @default("")
  startDate   DateTime
  endDate     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

// --- Structured Resume: Education ---

model Education {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startDate   DateTime
  endDate     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

// --- Structured Resume: Skills ---

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Skill {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  proficiency SkillProficiency @default(INTERMEDIATE)
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// --- Structured Resume: Extended Sections ---

model Project {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  link        String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([candidateId])
}

model Certification {
  id             Int       @id @default(autoincrement())
  candidateId    Int
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name           String
  issuer         String
  issueDate      DateTime?
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([candidateId])
}

model Language {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  proficiency String    @default("Conversational")
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

model Award {
  id          Int       @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  issuer      String?
  date        DateTime?
  description String?
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// --- Interview Scheduling ---

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Interview {
  id               Int       @id @default(autoincrement())
  jobApplicationId Int
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime
  durationMinutes  Int       @default(60)
  meetingLink      String?
  location         String?
  status           InterviewStatus @default(SCHEDULED)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([jobApplicationId])
}
